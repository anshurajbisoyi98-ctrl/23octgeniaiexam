# Copy this file to .env and fill in ONE provider's key.

# Which LLM answers questions: gemini | groq | ollama
LLM_PROVIDER=gemini

# Google Gemini (free key: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile



# Local embedding model (downloaded once from Hugging Face, no key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval settings
TOP_K=5
RELEVANCE_THRESHOLD=0.65
